# Copie para .env e ajuste se precisar.
PORT=3100
DATABASE_URL="postgresql://life:life@localhost:5433/life?schema=public"

# Segredo que assina os tokens de acesso (gere um proprio: openssl rand -hex 32).
JWT_SECRET="troque-este-valor"

# Enderecos que podem chamar a API. Vazio = libera todos (so em desenvolvimento).
CORS_ORIGIN=

# Envio de e-mail. Em desenvolvimento, o Mailpit do docker-compose.
# Sem SMTP_HOST, os e-mails sao apenas registrados no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USUARIO=
SMTP_SENHA=
SMTP_SEGURO=0
EMAIL_REMETENTE="LIFE <nao-responda@life.app>"

# Endereco do app, usado nos links dos e-mails.
APP_URL=http://localhost:5173

# Exigir e-mail confirmado para usar o app (AUTH-02). Use 0 enquanto nao
# houver provedor de e-mail configurado.
EXIGIR_EMAIL_VERIFICADO=1

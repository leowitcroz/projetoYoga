// Modelo de dados do LIFE.
// Nesta etapa só entram conta, consentimentos e as respostas do onboarding.
// O restante das entidades da seção 5 do plano entra no resto da Fase 2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta do aluno. A senha só existe como hash argon2 (AUTH-01).
model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  telefone     String
  senhaHash    String
  /// Quem pode o quê (ADM-01, ADM-10). Todo cadastro pelo app nasce ALUNO.
  papel        Role     @default(ALUNO)
  /// Quando a pessoa confirmou o e-mail (AUTH-02). Nulo = ainda não confirmou.
  emailVerificadoEm DateTime?
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  consentimentos Consent[]
  sessoes        RefreshToken[]
  perfil         OnboardingProfile?
  saude          HealthProfile?
  checkins       DailyCheckin[]
  recomendacoes  Recommendation[]
  conteudos      Content[]
  tokens         AuthToken[]
  eventos        PracticeEvent[]
}

/// O que a pessoa fez com a prática (F2.18).
///
/// É daqui que sai o histórico que o motor usa: antes ele supunha que a
/// prática recomendada tinha sido feita, o que nem sempre é verdade.
model PracticeEvent {
  id         String    @id @default(uuid())
  userId     String
  conteudoId String
  tipo       EventType
  /// Dia no fuso do aparelho (AAAA-MM-DD).
  dia        String

  /// Feedback de depois da prática. Só existe no evento de conclusão.
  gostou               Boolean?
  intensidadePercebida String?

  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dia])
  @@index([userId, conteudoId])
}

enum EventType {
  INICIADA
  CONCLUIDA
  /// A pessoa preferiu outra coisa: sinal de que a recomendação não serviu.
  TROCADA
}

/// Registro de acesso (PRIV-03).
///
/// Guarda só o necessário para investigar um incidente: quem, quando e de
/// onde. Nada de corpo de requisição — e, por tabela, nada de dado de saúde.
/// Some depois de 6 meses.
model AccessLog {
  id       String   @id @default(uuid())
  /// Fica mesmo depois de a conta ser apagada: é o único vestígio que a lei
  /// manda guardar (AUTH-07).
  userId   String?
  rota     String
  metodo   String
  ip       String?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@index([userId])
}

/// Link de uso único enviado por e-mail (AUTH-02, AUTH-04).
///
/// Guardamos só o hash: quem ler o banco não consegue entrar na conta de
/// ninguém, do mesmo jeito que acontece com o refresh token.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String
  tipo      AuthTokenType
  tokenHash String        @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
}

enum AuthTokenType {
  /// Confirmação de e-mail, válida por 24 h (AUTH-02).
  VERIFICACAO_EMAIL
  /// Redefinição de senha, válida por 1 h (AUTH-04).
  REDEFINICAO_SENHA
}

/// Papéis do sistema (ADM-01, ADM-10).
enum Role {
  /// Usa o app.
  ALUNO
  /// Cataloga as próprias práticas.
  PROFESSOR
  /// Professor master: também aprova o conteúdo dos outros.
  MASTER
  /// Gerencia pessoas, papéis e os pesos do motor.
  ADMIN
}

/// Registro de consentimento (PRIV-01). Cada aceite vira uma linha nova:
/// o histórico não é apagado nem sobrescrito.
model Consent {
  id       String      @id @default(uuid())
  userId   String
  tipo     ConsentType
  aceito   Boolean
  versao   String
  criadoEm DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
}

enum ConsentType {
  /// Política de privacidade e termos de uso.
  PRIVACIDADE
  /// Consentimento separado para dados de saúde (ONB-03).
  SAUDE
}

/// Sessão longa do aparelho (AUTH-03). Guardamos só o hash do refresh token,
/// para que um vazamento do banco não permita entrar na conta de ninguém.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiraEm  DateTime
  criadoEm  DateTime  @default(now())
  revogadoEm DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Respostas dos passos 1, 2, 4 e 5 do cadastro (ONB-01, ONB-02, ONB-05, ONB-06).
/// Saúde fica fora daqui de propósito: é um módulo separado.
model OnboardingProfile {
  id     String @id @default(uuid())
  userId String @unique

  /// Passo 1 — objetivos (ONB-01).
  objetivoPrincipal    String?
  objetivosSecundarios String[] @default([])

  /// Passo 2 — relação com o Yoga (ONB-02): área => nível.
  experiencia Json?

  /// Passo 4 — Ayurveda (ONB-05).
  constituicao String?
  estadoAtual  String?

  /// Passo 5 — preferências (ONB-06).
  estilos          String[] @default([])
  temas            String[] @default([])
  horarioPreferido String?

  /// Último passo concluído, para retomar de onde parou (ONB-08).
  passoConcluido Int      @default(0)
  atualizadoEm   DateTime @updatedAt
  criadoEm       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Passo 3 — saúde (ONB-04). Tabela separada: estes dados nunca entram em log
/// nem em resposta do painel (PRIV-02).
model HealthProfile {
  id     String @id @default(uuid())
  userId String @unique

  /// Condições marcadas pelo aluno, pelos códigos da tela.
  condicoes    String[] @default([])
  observacoes  String?
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Catálogo de práticas (aba 07 da Matriz). Os campos que o motor filtra têm
/// coluna própria; os que ele lê em bloco ficam em JSON.
model Content {
  id         String @id
  titulo     String
  tipo       String
  modalidade String
  duracaoMin Int
  /// 1 introdutório → 5 especializado.
  nivelTecnico Int
  /// 1 muito baixa → 5 muito alta.
  demandaFisica Int
  area   String
  /// Rascunho → Em revisão → Aprovado ou Devolvido (ADM-06).
  status ContentStatus @default(RASCUNHO)
  /// Quem cadastrou. Vazio nos conteúdos de teste, que não têm dono.
  autorId String?
  /// O que o master escreveu ao devolver.
  comentarioRevisao String?

  /// Imagem de capa escolhida pelo professor. Vazio = o app desenha a capa.
  capaUrl   String?
  /// Onde o vídeo está hospedado: 'youtube' hoje, 'mux' quando trocarmos (P-03).
  videoProvedor String?
  /// Identificador da mídia no provedor — não a URL, para a troca ser barata.
  videoId       String?
  /// Quem conduz a prática, como aparece para o aluno.
  professor String?

  /// Objetivos atendidos, com peso: { "sono": 5, "estresse": 4 }.
  objetivos Json
  /// O quanto entrega de cada dimensão do estado do dia.
  caracteristicas Json
  /// Cargas e marcas de segurança: cargaCervical, invertida, retencao...
  seguranca Json
  /// Tags ayurvédicas, quando houver.
  ayurveda Json?

  trilhaId    String?
  ordemTrilha Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  autor User? @relation(fields: [autorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([autorId])
  @@index([trilhaId, ordemTrilha])
}

/// Fluxo de aprovação do conteúdo (ADM-06).
enum ContentStatus {
  RASCUNHO
  EM_REVISAO
  APROVADO
  DEVOLVIDO
}

/// Check-in diário (CHK-01 a CHK-04). Um por pessoa por dia; refazer no mesmo
/// dia sobrescreve, e a recomendação é recalculada.
model DailyCheckin {
  id     String @id @default(uuid())
  userId String
  /// Data no fuso do aparelho, no formato AAAA-MM-DD (CHK-02).
  dia    String

  sono    String
  energia String
  corpo   String
  dor     String
  /// Onde dói, só quando há dor (CHK-03). É dado de saúde.
  regiaoDaDor String?
  estresse    String
  digestao    String
  humor       String
  tempo       Int
  /// Resposta da pergunta adaptativa sobre refeição recente (CTX-001).
  refeicaoRecente Boolean?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dia])
}

/// Recomendação entregue, com a auditoria do motor (MOT-10).
model Recommendation {
  id     String @id @default(uuid())
  userId String
  dia    String

  principalId     String?
  alternativaId   String?
  estadoFuncional String
  /// Versão da EngineConfig que gerou este resultado.
  versaoConfig String
  /// Candidatos, filtros, pontuação por critério e modificadores.
  auditoria Json

  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dia])
}

// Modelo de dados do LIFE.
// Nesta etapa só entram conta, consentimentos e as respostas do onboarding.
// O restante das entidades da seção 5 do plano entra no resto da Fase 2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta do aluno. A senha só existe como hash argon2 (AUTH-01).
model User {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  telefone     String
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  consentimentos Consent[]
  sessoes        RefreshToken[]
  perfil         OnboardingProfile?
  saude          HealthProfile?
  checkins       DailyCheckin[]
  recomendacoes  Recommendation[]
}

/// Registro de consentimento (PRIV-01). Cada aceite vira uma linha nova:
/// o histórico não é apagado nem sobrescrito.
model Consent {
  id       String      @id @default(uuid())
  userId   String
  tipo     ConsentType
  aceito   Boolean
  versao   String
  criadoEm DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tipo])
}

enum ConsentType {
  /// Política de privacidade e termos de uso.
  PRIVACIDADE
  /// Consentimento separado para dados de saúde (ONB-03).
  SAUDE
}

/// Sessão longa do aparelho (AUTH-03). Guardamos só o hash do refresh token,
/// para que um vazamento do banco não permita entrar na conta de ninguém.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiraEm  DateTime
  criadoEm  DateTime  @default(now())
  revogadoEm DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Respostas dos passos 1, 2, 4 e 5 do cadastro (ONB-01, ONB-02, ONB-05, ONB-06).
/// Saúde fica fora daqui de propósito: é um módulo separado.
model OnboardingProfile {
  id     String @id @default(uuid())
  userId String @unique

  /// Passo 1 — objetivos (ONB-01).
  objetivoPrincipal    String?
  objetivosSecundarios String[] @default([])

  /// Passo 2 — relação com o Yoga (ONB-02): área => nível.
  experiencia Json?

  /// Passo 4 — Ayurveda (ONB-05).
  constituicao String?
  estadoAtual  String?

  /// Passo 5 — preferências (ONB-06).
  estilos          String[] @default([])
  temas            String[] @default([])
  horarioPreferido String?

  /// Último passo concluído, para retomar de onde parou (ONB-08).
  passoConcluido Int      @default(0)
  atualizadoEm   DateTime @updatedAt
  criadoEm       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Passo 3 — saúde (ONB-04). Tabela separada: estes dados nunca entram em log
/// nem em resposta do painel (PRIV-02).
model HealthProfile {
  id     String @id @default(uuid())
  userId String @unique

  /// Condições marcadas pelo aluno, pelos códigos da tela.
  condicoes    String[] @default([])
  observacoes  String?
  atualizadoEm DateTime @updatedAt
  criadoEm     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Catálogo de práticas (aba 07 da Matriz). Os campos que o motor filtra têm
/// coluna própria; os que ele lê em bloco ficam em JSON.
model Content {
  id         String @id
  titulo     String
  tipo       String
  modalidade String
  duracaoMin Int
  /// 1 introdutório → 5 especializado.
  nivelTecnico Int
  /// 1 muito baixa → 5 muito alta.
  demandaFisica Int
  area          String
  aprovado      Boolean @default(false)

  /// Objetivos atendidos, com peso: { "sono": 5, "estresse": 4 }.
  objetivos Json
  /// O quanto entrega de cada dimensão do estado do dia.
  caracteristicas Json
  /// Cargas e marcas de segurança: cargaCervical, invertida, retencao...
  seguranca Json
  /// Tags ayurvédicas, quando houver.
  ayurveda Json?

  trilhaId    String?
  ordemTrilha Int?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([aprovado])
  @@index([trilhaId, ordemTrilha])
}

/// Check-in diário (CHK-01 a CHK-04). Um por pessoa por dia; refazer no mesmo
/// dia sobrescreve, e a recomendação é recalculada.
model DailyCheckin {
  id     String @id @default(uuid())
  userId String
  /// Data no fuso do aparelho, no formato AAAA-MM-DD (CHK-02).
  dia    String

  sono    String
  energia String
  corpo   String
  dor     String
  /// Onde dói, só quando há dor (CHK-03). É dado de saúde.
  regiaoDaDor String?
  estresse    String
  digestao    String
  humor       String
  tempo       Int

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dia])
}

/// Recomendação entregue, com a auditoria do motor (MOT-10).
model Recommendation {
  id     String @id @default(uuid())
  userId String
  dia    String

  principalId     String?
  alternativaId   String?
  estadoFuncional String
  /// Versão da EngineConfig que gerou este resultado.
  versaoConfig String
  /// Candidatos, filtros, pontuação por critério e modificadores.
  auditoria Json

  criadoEm DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dia])
}
